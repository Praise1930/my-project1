{
  "buildCommand": "cd system_files && npm install --include=dev && npm run build",
  "outputDirectory": "system_files/dist",
  "installCommand": "cd system_files && npm install --include=dev",
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/system_files/dist/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
