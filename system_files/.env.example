# ==========================================================================
# MamaTrack GPS — Supabase connection
# ==========================================================================
#
# Values come from the Supabase dashboard: Settings -> API
#   "Project URL"      -> VITE_SUPABASE_URL
#   Publishable key    -> VITE_SUPABASE_ANON_KEY  (sb_publishable_...)
#
# Copy this file to .env and fill in the values.
# ==========================================================================

VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# NOTE: there is deliberately no service_role key here any more.
# It bypasses RLS, so it must never reach a browser bundle — Vite would inline
# it into the public JavaScript. Admin operations (deleting a Supabase Auth
# identity, force-confirming an address) belong in a Supabase Edge Function or a
# serverless route that holds a secret key server-side.

# Canonical public URL of the deployment (no trailing slash).
# MUST match the Supabase "Site URL" and be listed under
# Authentication -> URL Configuration -> Redirect URLs.
# Set this in Vercel so account-confirmation emails always link back to the
# mothers' login portal instead of a protected preview deployment (which shows
# the Vercel sign-in page to anyone who clicks the link).
VITE_APP_URL="https://my-project1-peach.vercel.app"
