# ==========================================================================
# MamaTrack GPS — Supabase connection
# ==========================================================================
#
# Values come from the Supabase dashboard: Settings -> API
#   "Project URL"      -> VITE_SUPABASE_URL
#   "anon" / "public"  -> VITE_SUPABASE_ANON_KEY
#   "service_role"     -> VITE_SUPABASE_SERVICE_ROLE_KEY
#
# Copy this file to .env and fill in the values.
# ==========================================================================

VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Required for admin account deletion (deleting Supabase Auth users).
# ⚠ This key bypasses RLS — never expose it publicly.
VITE_SUPABASE_SERVICE_ROLE_KEY=""
