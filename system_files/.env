# ==========================================================================
# MamaTrack GPS — Supabase connection
# ==========================================================================
#
# Values come from the Supabase dashboard: Settings -> API
#   "Project URL"      -> VITE_SUPABASE_URL
#   "anon" / "public"  -> VITE_SUPABASE_ANON_KEY
#
# The anon key is intended to be shipped in browser code, so committing it is
# normal practice. Access is controlled by Row Level Security policies on the
# database, not by keeping this key secret. Never put the "service_role" key
# here — that one bypasses RLS and must stay server-side only.
#
# Vite inlines these at BUILD time, so after any change:
#   - Local: restart the dev server
#   - Live:  commit and push so Vercel rebuilds
# ==========================================================================

VITE_SUPABASE_URL="https://tdomiogiabjomkhjkres.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRkb21pb2dpYWJqb21raGprcmVzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUxMTEwNjksImV4cCI6MjEwMDY4NzA2OX0.gBVxScPK_BFdrXPW-ib2sxQ2ZZ0bebPCHvLhxwjiGOs"
